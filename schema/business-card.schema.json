{
 "$defs": {
  "soundAsset": {
   "properties": {
    "asset": {
     "description": "Content hash, never a bare filename",
     "pattern": "^(sha256:[0-9a-f]{64}|null)$",
     "type": [
      "string",
      "null"
     ]
    },
    "brief": {
     "type": "string"
    },
    "line": {
     "type": "string"
    },
    "seconds": {
     "type": "number"
    },
    "state": {
     "description": "ready only when the asset bytes exist",
     "enum": [
      "staged",
      "ready",
      "retired"
     ]
    },
    "voice": {
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/cryptonomicsed-byte/card-protocol/schema/business-card.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "A versioned, hash-chained, agent-readable business identity card. JSON keys: offerings/policies (plural); Markdown sections read Offer/Policy.",
 "properties": {
  "acting_hash": {
   "description": "SHA-256 of the canonical Acting layer (sections 1-9).",
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "appendix": {
   "additionalProperties": true,
   "description": "Not quotable, not in acting_hash. Personas, inferred competitors, SWOT, strategy notes.",
   "type": "object"
  },
  "changelog": {
   "items": {
    "properties": {
     "at": {
      "format": "date-time",
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "change": {
      "type": "string"
     },
     "version": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "handoff": {
   "additionalProperties": true,
   "type": "object"
  },
  "hash": {
   "description": "SHA-256 of the canonical full card. Never 'pending'.",
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "id": {
   "pattern": "^dna_",
   "type": "string"
  },
  "identity": {
   "additionalProperties": true,
   "properties": {
    "address": {
     "type": "string"
    },
    "elevator_pitch": {
     "description": "Implementation key for the one-sentence pitch (spec prose: pitch).",
     "type": "string"
    },
    "email": {
     "format": "email",
     "type": "string"
    },
    "founded": {
     "type": "string"
    },
    "mission": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "phone": {
     "type": "string"
    },
    "pitch": {
     "type": "string"
    },
    "source_url": {
     "format": "uri",
     "type": "string"
    },
    "timezone": {
     "type": "string"
    },
    "values": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "knowledge": {
   "items": {
    "properties": {
     "kind": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "uri": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "offerings": {
   "items": {
    "properties": {
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "kind": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "orderable": {
      "type": "boolean"
     },
     "price": {
      "description": "Null stays null. A made-up price is never allowed.",
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "operations": {
   "additionalProperties": true,
   "type": "object"
  },
  "organization_id": {
   "type": "string"
  },
  "policies": {
   "items": {
    "properties": {
     "action": {
      "enum": [
       "allow",
       "deny",
       "ask",
       "handoff"
      ]
     },
     "rule": {
      "type": "string"
     },
     "topic": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "previous_hash": {
   "pattern": "^([0-9a-f]{64}|none)$",
   "type": "string"
  },
  "sound": {
   "properties": {
    "logo": {
     "$ref": "#/$defs/soundAsset"
    },
    "ui": {
     "properties": {
      "error": {
       "$ref": "#/$defs/soundAsset"
      },
      "notification": {
       "$ref": "#/$defs/soundAsset"
      },
      "success": {
       "$ref": "#/$defs/soundAsset"
      }
     },
     "type": "object"
    },
    "voice_logo": {
     "$ref": "#/$defs/soundAsset"
    }
   },
   "type": "object"
  },
  "status": {
   "enum": [
    "draft",
    "owner-confirmed",
    "live"
   ]
  },
  "created_at": {
   "format": "date-time",
   "type": "string"
  },
  "version": {
   "minimum": 1,
   "type": "integer"
  },
  "voice": {
   "additionalProperties": true,
   "properties": {
    "donts": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "lexicon": {
     "properties": {
      "never": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "use": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "personality": {
     "type": "string"
    },
    "sample_phrases": {
     "description": "Implementation key (spec prose: samples).",
     "items": {
      "type": "string"
     },
     "maxItems": 5,
     "minItems": 3,
     "type": "array"
    },
    "tone": {
     "description": "Array in the 0.1 implementations (joined with ', ' on emit).",
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "field_provenance": {
   "type": "object",
   "description": "Implementation key (spec prose: Provenance section). Field-keyed provenance records.",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "sources": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "extractor_agent": {
      "type": "string"
     },
     "extracted_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  }
 },
 "required": [
  "id",
  "version",
  "hash",
  "acting_hash",
  "status",
  "identity"
 ],
 "title": "business-card/0.1",
 "type": "object"
}