{
 "$defs": {
  "soundAsset": {
   "properties": {
    "asset": {
     "description": "Content hash, never a bare filename",
     "pattern": "^(sha256:[0-9a-f]{64}|null)$",
     "type": [
      "string",
      "null"
     ]
    },
    "brief": {
     "type": "string"
    },
    "line": {
     "type": "string"
    },
    "seconds": {
     "type": "number"
    },
    "state": {
     "description": "ready only when the asset bytes exist",
     "enum": [
      "staged",
      "ready",
      "retired"
     ]
    },
    "voice": {
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/cryptonomicsed-byte/card-protocol/schema/business-card.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "allOf": [
  {
   "description": "tier_hashes is mandatory for business-card/0.2 cards. 0.1 cards (or cards without a format discriminator) validate without it.",
   "if": {
    "properties": {
     "format": {
      "const": "business-card/0.2"
     }
    },
    "required": [
     "format"
    ]
   },
   "then": {
    "required": [
     "tier_hashes"
    ]
   }
  }
 ],
 "description": "A versioned, hash-chained, agent-readable business identity card. Covers business-card/0.1 and business-card/0.2; the `format` discriminator (supplied by the parser from frontmatter, validation metadata only) gates 0.2 requirements. JSON keys: offerings/policies (plural); Markdown sections read Offer/Policy.",
 "properties": {
  "acting_hash": {
   "description": "SHA-256 of the canonical Acting layer: the locked seven-key set (identity, voice, offerings, operations, policies, handoff, knowledge). See tier-annex-0.2 \u00a715 R1.",
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "appendix": {
   "additionalProperties": true,
   "description": "Not quotable, not in acting_hash. Personas, inferred competitors, SWOT, strategy notes.",
   "type": "object"
  },
  "changelog": {
   "items": {
    "properties": {
     "at": {
      "format": "date-time",
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "change": {
      "type": "string"
     },
     "version": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "created_at": {
   "format": "date-time",
   "type": "string"
  },
  "field_provenance": {
   "additionalProperties": {
    "properties": {
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "extracted_at": {
      "format": "date-time",
      "type": "string"
     },
     "extractor_agent": {
      "type": "string"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "description": "Implementation key (spec prose: Provenance section). Field-keyed provenance records.",
   "type": "object"
  },
  "format": {
   "description": "Supplied by the parser from CARD.md frontmatter for validation only. Not part of the canonical card: validators MUST strip it before canonicalization/hashing. Gates 0.2 requirements via the allOf conditional below.",
   "enum": [
    "business-card/0.1",
    "business-card/0.2"
   ],
   "type": "string"
  },
  "handoff": {
   "additionalProperties": true,
   "type": "object"
  },
  "hash": {
   "description": "SHA-256 of the canonical full card. Never 'pending'.",
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "id": {
   "pattern": "^dna_",
   "type": "string"
  },
  "identity": {
   "additionalProperties": true,
   "properties": {
    "address": {
     "type": "string"
    },
    "elevator_pitch": {
     "description": "Implementation key for the one-sentence pitch (spec prose: pitch).",
     "type": "string"
    },
    "email": {
     "format": "email",
     "type": "string"
    },
    "founded": {
     "type": "string"
    },
    "mission": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "phone": {
     "type": "string"
    },
    "pitch": {
     "type": "string"
    },
    "source_url": {
     "format": "uri",
     "type": "string"
    },
    "timezone": {
     "type": "string"
    },
    "values": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "infrastructure": {
   "additionalProperties": true,
   "description": "Where the card's agent runs. Operator knowledge; authorized tier. No secrets \u2014 credentials live in the vault, never here.",
   "properties": {
    "deployments": {
     "items": {
      "additionalProperties": true,
      "properties": {
       "id": {
        "type": "string"
       },
       "provider": {
        "type": "string",
        "description": "Free-form operator label."
       },
       "region": {
        "type": "string"
       },
       "sandbox": {
        "type": "string",
        "description": "Sandbox substrate label, e.g. docker+gvisor, openshell."
       }
      },
      "required": [
       "id",
       "provider",
       "sandbox"
      ],
      "type": "object"
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "knowledge": {
   "items": {
    "properties": {
     "kind": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "uri": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "networks": {
   "additionalProperties": true,
   "description": "How the outside world reaches the card's agent, keyed by purpose. Private keys MUST NEVER appear anywhere in this map.",
   "properties": {
    "voice": {
     "additionalProperties": true,
     "description": "Voice-call pointer. Shape mirrors the verified Meshenger contact JSON. networks.voice is public tier.",
     "properties": {
      "addresses": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Dialable addresses (Meshenger: TCP 10001)."
      },
      "protocol": {
       "type": "string",
       "description": "\"meshenger\" is the 0.2-defined voice protocol."
      },
      "public_key": {
       "type": "string",
       "pattern": "^[0-9a-f]+$",
       "description": "Hex ed25519 identity proof. Public by design."
      },
      "visibility": {
       "type": "string",
       "enum": [
        "public",
        "authorized"
       ],
       "default": "public"
      }
     },
     "propertyNames": {
      "pattern": "^(?!.*private_key).*$"
     },
     "required": [
      "protocol",
      "public_key",
      "addresses"
     ],
     "type": "object"
    }
   },
   "type": "object"
  },
  "offerings": {
   "items": {
    "properties": {
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "kind": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "orderable": {
      "type": "boolean"
     },
     "price": {
      "description": "Null stays null. A made-up price is never allowed.",
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "operations": {
   "additionalProperties": true,
   "type": "object"
  },
  "organization_id": {
   "type": "string"
  },
  "policies": {
   "items": {
    "properties": {
     "action": {
      "enum": [
       "allow",
       "deny",
       "ask",
       "handoff"
      ]
     },
     "rule": {
      "type": "string"
     },
     "topic": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "previous_hash": {
   "pattern": "^([0-9a-f]{64}|none)$",
   "type": "string"
  },
  "sound": {
   "properties": {
    "logo": {
     "$ref": "#/$defs/soundAsset"
    },
    "ui": {
     "properties": {
      "error": {
       "$ref": "#/$defs/soundAsset"
      },
      "notification": {
       "$ref": "#/$defs/soundAsset"
      },
      "success": {
       "$ref": "#/$defs/soundAsset"
      }
     },
     "type": "object"
    },
    "voice_logo": {
     "$ref": "#/$defs/soundAsset"
    }
   },
   "type": "object"
  },
  "status": {
   "enum": [
    "draft",
    "owner-confirmed",
    "live"
   ]
  },
  "tier_hashes": {
   "additionalProperties": false,
   "description": "SHA-256 of each tier view's canonical PLAINTEXT JSON (tier-annex-0.2 \u00a76). Mandatory when format is business-card/0.2.",
   "properties": {
    "authorized": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "owner": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "public": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   },
   "required": [
    "public",
    "authorized",
    "owner"
   ],
   "type": "object"
  },
  "version": {
   "minimum": 1,
   "type": "integer"
  },
  "voice": {
   "additionalProperties": true,
   "properties": {
    "donts": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "lexicon": {
     "properties": {
      "never": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "use": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "personality": {
     "type": "string"
    },
    "sample_phrases": {
     "description": "Implementation key (spec prose: samples).",
     "items": {
      "type": "string"
     },
     "maxItems": 5,
     "minItems": 3,
     "type": "array"
    },
    "tone": {
     "description": "Array in the 0.1 implementations (joined with ', ' on emit).",
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "type": "object"
  }
 },
 "required": [
  "id",
  "version",
  "hash",
  "acting_hash",
  "status",
  "identity"
 ],
 "title": "business-card",
 "type": "object"
}
